// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "code_lens": "on",
  "use_system_window_tabs": false,
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": false,
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "entry_spacing": "comfortable",
    "hide_root": false,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "colorize_brackets": true,
  "helix_mode": false,
  "context_servers": {},
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  "agent": {
    "sidebar_side": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "right",
    "notify_when_agent_waiting": "never",
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
    "default_profile": "write",
    "model_parameters": [],
  },
  "base_keymap": "JetBrains",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 15.0,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": true,
    "terraform": true,
    "toml": true,
    "material-icon-theme": true,
    "basedpyright": true,
    "ruff": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "load_direnv": "direct",
  "terminal": {
    "shell": {
      "program": "fish",
    },
    "dock": "bottom",
    "blinking": "off",
    "detect_venv": {
      "on": {
        "activate_script": "fish",
      },
    },
  },
  "languages": {
    "Python": {
      "inlay_hints": {
        "enabled": true,
      },
      "language_servers": ["pyrefly", "!zuban", "!ty", "!basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  "lsp": {
    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },
    "pyrefly": {
      "binary": {
        "path": "~/.local/bin/pyrefly",
        "arguments": ["lsp"],
      },
    },
    "ty": {
      "settings": {
        "inlayHints": {
          "variableTypes": true,
          "callArgumentNames": true,
        },
        "completions": {
          "autoImport": true,
        },
      },
    },
  },
  "journal": {
    "path": "~/GitHub",
    "hour_format": "hour24",
  },
  "minimap": {
    "show": "auto",
    "current_line_highlight": "all",
    "thumb": "always",
    "thumb_border": "full",
  },
}
